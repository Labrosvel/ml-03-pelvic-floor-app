    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.13",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.1",
    "expo-haptics": "^57.0.1",
    "expo-linear-gradient": "^57.0.1",
    "expo-linking": "~57.0.6",
    "expo-localization": "^57.0.1",
    "expo-notifications": "~57.0.11",
    "expo-router": "~57.0.13",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-updates": "~57.0.14",
    "expo-web-browser": "~57.0.2",
    "i18next": "^26.3.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^17.0.11",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "xmlbuilder": "^11.0.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.2",
    "eas-cli": "^22.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:dev-client": "expo start --dev-client",
    "start:dev-client:tunnel": "expo start --dev-client --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export -p web",
    "typecheck": "tsc --noEmit",
    "update:production": "eas update --channel production --environment production",
    "update:preview": "eas update --channel preview --environment preview",
    "build:android:development": "eas build -p android --profile development",
    "build:android:preview": "eas build -p android --profile preview",
    "build:android:production": "eas build -p android --profile production",
    "submit:android": "eas submit -p android --profile production"
  },
  "private": true
}
